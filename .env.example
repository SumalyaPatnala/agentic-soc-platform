# Copy to .env and adjust locally.

# Service
APP_ENV=local
LOG_LEVEL=info

# HTTP server
HOST=0.0.0.0
PORT=8000

# Local telemetry dataset (Splunk BOTS v3), used in a later milestone
BOTSV3_DATA_DIR=./data/botsv3

# Local Apache Kafka (PLAINTEXT, no credentials, no cloud)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_TOPIC=soc.raw.events
KAFKA_NORMALIZED_TOPIC=soc.normalized.events
KAFKA_EVIDENCE_TOPIC=soc.evidence.events
KAFKA_DLQ_TOPIC=soc.deadletter
KAFKA_NORMALIZER_GROUP=soc-normalizer-v1
KAFKA_EVIDENCE_GROUP=soc-evidence-v1
